{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "types": ["svelte", "node"]
  },
  "include": ["apps/desktop/ui/**/*.ts", "apps/desktop/ui/**/*.svelte", "tests/**/*.ts", "*.ts"]
}
